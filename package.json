{
  "name": "atm-launcher",
  "productName": "ATM Launcher",
  "version": "1.0.0",
  "releaseName": "Sweet Minecraft Treat",
  "description": "ATM Launcher - launcher officiel du serveur All the Mod, saison 3",
  "main": "src/bootstrap.js",
  "desktopName": "atm-launcher.desktop",
  "private": true,
  "scripts": {
    "start": "electron .",
    "manifest": "node tools/build-manifest.js server-example",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "qc.atm.launcher",
    "productName": "ATM Launcher",
    "files": [
      "src/**/*",
      "launcher.config.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ATM",
      "runAfterFinish": true,
      "artifactName": "ATM-Setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Game",
      "artifactName": "ATM-Launcher.${ext}",
      "synopsis": "Launcher du serveur All the Mod",
      "syncDesktopName": true
    }
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.17.0"
  }
}
